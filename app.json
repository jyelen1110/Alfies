{
  "expo": {
    "name": "Alfies",
    "slug": "alfies-ordering",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5DADE2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.easyordering.app",
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5DADE2"
      },
      "package": "com.easyordering.app",
      "versionCode": 11
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Alfies",
      "shortName": "Alfies"
    },
    "plugins": [
      "expo-asset",
      "expo-web-browser",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-updates"
    ],
    "updates": {
      "url": "https://u.expo.dev/ccb4367c-698d-4604-a21d-a46896932631"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "ccb4367c-698d-4604-a21d-a46896932631"
      }
    }
  }
}
